{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushTheEvtxkitImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage"
      ],
      "Resource": "arn:aws:ecr:eu-north-1:772325758655:repository/evtxkit"
    },
    {
      "Sid": "RegisterTheTaskDefinition",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "RunTheTestTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": [
        "arn:aws:ecs:eu-north-1:772325758655:task-definition/evtxkit-task:*"
      ],
      "Condition": {
        "ArnEquals": { "ecs:cluster": "arn:aws:ecs:eu-north-1:772325758655:cluster/evtxkit-cluster" }
      }
    },
    {
      "Sid": "PassTheTasksTwoRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::772325758655:role/ecsTaskExecutionRole",
        "arn:aws:iam::772325758655:role/evtxkitTaskRole"
      ],
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" }
      }
    }
  ]
}
