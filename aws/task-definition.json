{
  "family": "evtxkit-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::772325758655:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::772325758655:role/evtxkitTaskRole",
  "containerDefinitions": [
    {
      "name": "evtxkit",
      "image": "772325758655.dkr.ecr.eu-north-1.amazonaws.com/evtxkit:v1",
      "essential": true,
      "command": ["rules"],
      "environment": [
        { "name": "REPORT_BUCKET", "value": "evtxkit-reports-772325758655" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/evtxkit",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "evtxkit"
        }
      }
    }
  ]
}