{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadUploadedEvidence",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::evtxkit-uploads-772325758655/*"
    },
    {
      "Sid": "DeleteTheUploadOnceAnalysed",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::evtxkit-uploads-772325758655/uploads/*"
    }
  ]
}
