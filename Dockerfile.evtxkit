FROM python:3.12-slim

# Unbuffered: log lines reach CloudWatch as they are written, in order.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN pip install --no-cache-dir boto3

COPY evtxkit/ ./evtxkit/
COPY soccore/ ./soccore/
COPY s3_wrapper.py .

# This image reads files uploaded by other people: never do that as root.
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin evtxkit
USER evtxkit

ENTRYPOINT ["python3", "s3_wrapper.py"]

CMD ["--help"]
